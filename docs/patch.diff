 using namespace gift;
 namespace {
 void check(bool ok,const char *message) { if(!ok) throw std::runtime_error(message); }
-NSError *errorFor(const std::string &message) { return [NSError errorWithDomain:@"Companion" code:1 userInfo:@{NSLocalizedDescriptionKey:[NSString stringWithUTF8String:message.c_str()]}]; }
+// std::exception::what() is not guaranteed to be valid UTF-8: cgltf and the JSON
+// reader put asset-controlled strings into error messages. -[NSString
+// stringWithUTF8String:] returns nil for invalid UTF-8, and a nil value in a
+// dictionary literal raises NSInvalidArgumentException, which no C++ catch block
+// and no Swift do/catch can observe.
+NSError *errorFor(const std::string &message) {
+    NSString *text = [[NSString alloc] initWithBytes:message.data() length:message.size() encoding:NSUTF8StringEncoding];
+    if (!text) text = [[NSString alloc] initWithBytes:message.data() length:message.size() encoding:NSISOLatin1StringEncoding];
+    if (!text) text = [NSString stringWithFormat:@"Companion error (%lu bytes, non-text payload)", (unsigned long)message.size()];
+    return [NSError errorWithDomain:@"Companion" code:1 userInfo:@{NSLocalizedDescriptionKey: text}];
+}
